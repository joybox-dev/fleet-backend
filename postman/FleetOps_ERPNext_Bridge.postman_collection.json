	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "api_key", "value": "", "type": "string" },
		{ "key": "api_secret", "value": "", "type": "string" },
		{ "key": "sid", "value": "", "type": "string" },
		{ "key": "company", "value": "FleetOps", "type": "string" },
		{ "key": "currency", "value": "KWD", "type": "string" },
		{ "key": "cost_center", "value": "Main - FO", "type": "string" },
		{ "key": "customer_name", "value": "", "type": "string" },
		{ "key": "employee_name", "value": "", "type": "string" },
		{ "key": "asset_name", "value": "", "type": "string" },
