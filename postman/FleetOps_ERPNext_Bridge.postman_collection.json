				{
					"name": "Discover: Auto-Detect Accounts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var data = pm.response.json().data;",
									"    var map = {};",
									"    data.forEach(a => {",
									"        if (a.account_type === 'Cash' && !map.cash) map.cash = a.name;",
									"        if (a.account_type === 'Receivable' && !map.receivable) map.receivable = a.name;",
									"        if (a.account_type === 'Payable' && !map.payable) map.payable = a.name;",
									"        if (a.account_type === 'Fixed Asset' && !map.fixed_asset) map.fixed_asset = a.name;",
									"        if (a.name.includes('Salary') && !map.salary) map.salary = a.name;",
									"        if (a.name.includes('Service') && a.root_type === 'Income' && !map.income) map.income = a.name;",
									"    });",
									"    pm.collectionVariables.set('account_cash', map.cash || '');",
									"    pm.collectionVariables.set('account_receivable', map.receivable || '');",
									"    pm.collectionVariables.set('account_payable', map.payable || '');",
									"    pm.collectionVariables.set('account_asset', map.fixed_asset || '');",
									"    pm.collectionVariables.set('account_salary', map.salary || '');",
									"    pm.collectionVariables.set('account_income', map.income || '');",
									"    console.log('Accounts discovered:', JSON.stringify(map));",
									"    pm.test('Accounts auto-discovered', () => pm.expect(Object.keys(map).length).to.be.above(3));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Cookie", "value": "sid={{sid}}" }],
						"url": {
							"raw": "{{base_url}}/api/resource/Account?fields=[\"name\",\"account_type\",\"root_type\",\"is_group\"]&filters=[[\"company\",\"=\",\"{{company}}\"],[\"is_group\",\"=\",0]]&limit_page_length=200",
							"host": ["{{base_url}}"],
							"path": ["api", "resource", "Account"],
							"query": [
