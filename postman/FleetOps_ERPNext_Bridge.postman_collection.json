	"item": [
		{
			"name": "00 - Auth",
			"item": [
				{
					"name": "Login (Get Session)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var cookies = pm.response.headers.filter(h => h.key === 'Set-Cookie');",
									"    cookies.forEach(c => {",
									"        if (c.value.startsWith('sid=')) {",
									"            var sid = c.value.split(';')[0].split('=')[1];",
									"            pm.collectionVariables.set('sid', sid);",
									"            console.log('Session ID saved: ' + sid);",
									"        }",
									"    });",
									"    pm.test('Login successful', () => pm.response.to.have.status(200));",
									"    pm.test('Got valid session', () => {",
									"        var json = pm.response.json();",
									"        pm.expect(json.message).to.not.equal('Guest');",
									"    });",
									"} else {",
									"    pm.test('Login failed', () => pm.expect.fail('Status: ' + pm.response.code));",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usr\": \"Administrator\",\n    \"pwd\": \"admin\"\n}"
						},
						"url": "{{base_url}}/api/method/login"
					}
				},
				{
					"name": "Get Logged User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Authenticated', () => {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json.message).to.not.equal('Guest');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Cookie", "value": "sid={{sid}}" }],
						"url": "{{base_url}}/api/method/frappe.auth.get_logged_user"
					}
				},
				{
					"name": "Ping (Version Check)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('ERPNext reachable', () => pm.response.to.have.status(200));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Cookie", "value": "sid={{sid}}" }],
						"url": "{{base_url}}/api/method/frappe.utils.change_log.get_versions"
					}
				}
			]
		},
